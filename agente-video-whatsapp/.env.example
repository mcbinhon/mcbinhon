# ============================================================
#  Agente de Vídeo pelo WhatsApp — configuração
#  Copie este arquivo para ".env" e preencha.
# ============================================================

# --- Quem pode usar o agente (SÓ esses números são atendidos) ---
# Formato: código do país + DDD + número, só dígitos. Vários: separe por vírgula.
ALLOWED_NUMBERS=5541999999999

# Palavra que inicia um pedido
TRIGGER_WORD=edição

# --- Evolution API (sobe pelo docker-compose.yml) ---
EVOLUTION_URL=http://localhost:8080
# Mesma chave do AUTHENTICATION_API_KEY abaixo (invente uma longa)
EVOLUTION_API_KEY=troque-por-uma-chave-longa-e-secreta
EVOLUTION_INSTANCE=agente-video

# --- Servidor do agente + painel ---
PORT=3333
# Segredo que vai na URL do webhook (invente outro)
WEBHOOK_SECRET=troque-este-segredo-do-webhook
# Como o container da Evolution enxerga este PC (padrão do Docker Desktop)
WEBHOOK_HOST=host.docker.internal
# Opcional: senha para abrir o painel de OUTRO computador da rede (?token=...).
# Vazio = painel só abre no próprio PC (localhost).
DASHBOARD_TOKEN=

# --- Claude Code ---
# Caminho do executável (no Windows normalmente basta "claude")
CLAUDE_BIN=claude
# Opcional: modelo (ex.: opus, sonnet). Vazio = padrão da sua conta.
CLAUDE_MODEL=
# Tempo máximo de um vídeo (minutos) antes de abortar
JOB_TIMEOUT_MIN=45
# Opcional: pasta com sua identidade visual (logo.png, cores.txt, fontes...)
MARCA_DIR=
# Opcional: instruções fixas extras para todo vídeo
AGENT_EXTRA=

# --- Entrega ---
# Acima desse tamanho o vídeo é comprimido; se ainda ficar grande vai como documento
MAX_WHATSAPP_VIDEO_MB=15
MAX_AJUSTES=5
# Minutos sem resposta para um pedido em conversa expirar
CONVERSA_EXPIRA_MIN=120
# Cotação para mostrar custo em reais no painel
USD_BRL=5.40

# Pasta onde ficam banco de dados, mídias e vídeos
DATA_DIR=./dados

# ============================================================
#  Variáveis lidas pelo container da Evolution API
# ============================================================
AUTHENTICATION_API_KEY=troque-por-uma-chave-longa-e-secreta
SERVER_URL=http://localhost:8080
LANGUAGE=pt-BR
DEL_INSTANCE=false
CONFIG_SESSION_PHONE_CLIENT=Agente Video
CONFIG_SESSION_PHONE_NAME=Chrome
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution@evolution-postgres:5432/evolution?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=agente_video
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false
POSTGRES_USER=evolution
POSTGRES_PASSWORD=evolution
POSTGRES_DB=evolution
